---
import '../styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { ui, site, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 只提供实际存在的语言版本，避免声明无效的 hreflang */
  paths: { zh?: string; en?: string };
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** 正文是否居中窄栏（文章页用） */
  narrow?: boolean;
  /** 标题后是否追加站点品牌；文档页标题已含产品名，不再追加 */
  appendBrand?: boolean;
}

const { lang, title, description, paths, jsonLd = [], noindex = false, narrow = true, appendBrand = true } = Astro.props;
const t = ui[lang];
const abs = (p: string) => new URL(p, Astro.site).href;
const current = paths[lang] ?? (lang === 'zh' ? '/' : '/en/');
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const altPath = paths[other] ?? (other === 'en' ? '/en/' : '/');
const defaultPath = paths.zh ?? paths.en ?? '/';

const pageTitle = !appendBrand || current === '/' || current === '/en/' ? title : `${title} · ${t.brand}`;
// 只有文章详情页是 article；/blog/ 这类列表页仍是 website
const isArticle = /^\/(en\/)?blog\/.+/.test(current);
const ogImage = new URL(site.ogImage, Astro.site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="baidu-site-verification" content="codeva-dYTZpNJ9R7" />
    <link rel="canonical" href={abs(current)} />
    {paths.zh && <link rel="alternate" hreflang="zh-CN" href={abs(paths.zh)} />}
    {paths.en && <link rel="alternate" hreflang="en" href={abs(paths.en)} />}
    <link rel="alternate" hreflang="x-default" href={abs(defaultPath)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(current)} />
    <meta property="og:locale" content={t.ogLocale} />
    {paths[other] && <meta property="og:locale:alternate" content={ui[other].ogLocale} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <Nav lang={lang} path={current} altPath={altPath} />
    <main id="main" class={narrow ? 'wrap' : 'wrap wrap-wide'}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
