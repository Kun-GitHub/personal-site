---
import Base from '@/layouts/Base.astro';
import { ui } from '@/i18n/ui';

const t = ui.zh;
---

<Base lang="zh" title={t.notFound.title} description={t.notFound.lead} paths={{ zh: '/404' }} noindex narrow={false}>
  <div class="nf wrap">
    <p class="eyebrow">404</p>
    <h1 style="margin-top:10px">{t.notFound.title}</h1>
    <p>{t.notFound.lead}</p>
    <a class="btn btn-primary" href="/">{t.notFound.back}</a>
  </div>
</Base>
