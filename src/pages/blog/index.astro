---
import Base from '@/layouts/Base.astro';
import { ui } from '@/i18n/ui';
import { listPosts, postPath, formatDate } from '@/lib/content';

const lang = 'zh' as const;
const t = ui[lang];
const posts = await listPosts(lang);
const here = lang === 'zh' ? '/blog/' : '/en/blog/';
---

<Base
  lang={lang}
  title={t.nav[1].label}
  description={lang === 'zh' ? '技术笔记与实践记录。' : 'Notes and write-ups.'}
  paths={{ zh: '/blog/', en: '/en/blog/' }}
>
  <header class="page-head">
    <h1>{t.nav[1].label}</h1>
    <p class="lead">{lang === 'zh' ? '技术笔记与实践记录。' : 'Notes and write-ups.'}</p>
  </header>

  <div class="list" style="margin-bottom:56px">
    {posts.length === 0 && <p class="muted">{t.tags.empty}</p>}
    {posts.map((post) => {
      const slug = post.id.split('/').slice(1).join('/');
      return (
        <a class="row" href={postPath(lang, slug)}>
          <span class="t">{post.data.title}</span>
          <span class="d">{formatDate(post.data.date, lang)}</span>
          <span class="sub">{post.data.description}</span>
        </a>
      );
    })}
  </div>
</Base>
