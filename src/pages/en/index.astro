---
import Base from '@/layouts/Base.astro';
import { ui, site } from '@/i18n/ui';
import { listPosts, postPath, formatDate } from '@/lib/content';
import { products } from '@/data/products';
import { openSource } from '@/data/openSource';
import ProjectCard from '@/components/ProjectCard.astro';
import { docPath, productsWithDocs } from '@/lib/content';

const lang = 'en' as const;
const t = ui[lang];
const posts = (await listPosts(lang)).slice(0, 3);
const withDocs = await productsWithDocs(lang);
const here = lang === 'zh' ? '/' : '/en/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: new URL(here, Astro.site).href,
    jobTitle: 'Software Engineer and Technical Lead',
    knowsAbout: ['Smart hardware', 'IoT', 'Audio/video', 'SaaS', 'System architecture', 'Go', 'Java', 'Android', 'iOS'],
    sameAs: [site.github],
  },
];
---

<Base
  lang={lang}
  title={lang === 'zh' ? 'Kong · 软件开发与产品实践' : 'Kong · Software development and products'}
  description={lang === 'zh'
    ? '软件工程师与技术负责人，关注智能硬件、物联网、音视频与 SaaS，记录产品研发、系统架构、团队交付和开源实践。'
    : 'Software engineer and technical lead across smart hardware, IoT, audio/video and SaaS. Notes on product development, architecture and delivery.'}
  paths={{ zh: '/', en: '/en/' }}
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="lead">
      {lang === 'zh'
        ? '我是一名软件工程师与技术负责人，长期参与智能硬件、物联网、音视频和 SaaS 产品研发，经验覆盖 Android 与 iOS、Java 与 Go 服务端、系统架构和云原生基础设施，也负责技术决策、核心开发与团队协作，持续把产品从方案推进到可靠交付。'
        : 'I am a software engineer and technical lead working across smart hardware, IoT, audio/video and SaaS products, from Android and iOS apps to Java and Go services, system architecture, cloud-native infrastructure and team delivery; I turn that work into products, open-source projects and practical engineering notes.'}
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={lang === 'zh' ? '/blog/' : '/en/blog/'}>{t.nav[1].label}</a>
      <a class="btn btn-ghost" href={lang === 'zh' ? '/products/' : '/en/products/'}>{t.nav[2].label}</a>
    </div>
    <p class="hero-meta">
      {lang === 'zh' ? '正在开发：' : 'In development: '}
      <a href={docPath(lang, 'training-platform')} style="color:var(--accent)">{lang === 'zh' ? '大肥鱼项目实训平台' : 'Dafeiyu Project Training Platform'} →</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>{t.tags.latest}</h2>
      <a href={lang === 'zh' ? '/blog/' : '/en/blog/'}>{t.tags.morePosts} →</a>
    </div>
    <div class="list">
      {posts.length === 0 && <p class="muted">{t.tags.empty}</p>}
      {posts.map((post) => {
        const slug = post.id.split('/').slice(1).join('/');
        return (
          <a class="row" href={postPath(lang, slug)}>
            <span class="t">{post.data.title}</span>
            <span class="d">{formatDate(post.data.date, lang)}</span>
            <span class="sub">{post.data.description}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>{t.tags.products}</h2>
      <a href={lang === 'zh' ? '/products/' : '/en/products/'}>{t.tags.allProducts} →</a>
    </div>
    <div class="grid">
      {products.map((p) => (
        <div class="card">
          <h3>{p.name[lang]}<span class="badge">{p.status[lang]}</span></h3>
          <p>{p.tagline[lang]}</p>
          <div class="card-links">
            {withDocs.includes(p.slug) && <a href={docPath(lang, p.slug)}>{t.tags.docs} →</a>}
            <a href={p.url} rel="noopener">{t.tags.site} →</a>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="section-head">
      <h2>{t.tags.projects}</h2>
      <a href={lang === 'zh' ? '/projects/' : '/en/projects/'}>{t.tags.allProjects} →</a>
    </div>
    <div class="grid">
      {openSource.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
</Base>
